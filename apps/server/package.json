{
  "name": "@openstatuspage/server",
  "version": "0.3.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/dev.ts",
    "build": "tsup",
    "start": "node --max-opt=2 dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "create-user": "tsx src/cli/create-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "mysql2": "3.24.6",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openstatuspage/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
