{
  "name": "openstatuspage",
  "private": true,
  "version": "0.3.0",
  "description": "Self-hosted status page that keeps your infrastructure private",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r --filter './apps/*' build",
    "start": "pnpm --filter @openstatuspage/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @openstatuspage/server db:migrate",
    "db:seed": "pnpm --filter @openstatuspage/server db:seed",
    "measure:memory": "node scripts/measure-memory.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@node-rs/argon2",
      "esbuild"
    ],
    "overrides": {
      "mysql2>sql-escaper": "1.5.2"
    }
  }
}
