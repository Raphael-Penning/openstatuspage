{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenStatusPage chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretName": {
      "description": "Name of an existing Kubernetes Secret, or empty.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
    },
    "url": {
      "type": "string",
      "pattern": "^(|https?://[^/?#\\s]+)$"
    },
    "postgresUrl": {
      "type": "string",
      "pattern": "^(|postgres(ql)?://.+)$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "envValue": {
      "type": ["string", "number", "boolean", "null"]
    },
    "boolString": {
      "type": ["string", "boolean"],
      "pattern": "^(|true|false|1|0|yes|no)$"
    },
    "intString": {
      "type": ["string", "integer"],
      "pattern": "^[0-9]*$"
    },
    "numberString": {
      "type": ["string", "number"],
      "pattern": "^([0-9]+(\\.[0-9]+)?)?$"
    },
    "percentOrEmpty": {
      "description": "Integer percentage, or empty (off).",
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 100 },
        { "type": "string", "maxLength": 0 },
        { "type": "null" }
      ]
    },
    "list": { "type": "array" },
    "object": { "type": "object" },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": { "type": "object" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "$ref": "#/definitions/list" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "$ref": "#/definitions/list" },
        "affinity": { "$ref": "#/definitions/object" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "egressRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": ["boolean", "string"] },
        "to": { "type": "array", "items": { "type": "object" } },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": { "type": ["integer", "string"] },
              "endPort": { "type": "integer" },
              "protocol": { "enum": ["TCP", "UDP", "SCTP"] }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "autoEgressRule": {
      "allOf": [{ "$ref": "#/definitions/egressRule" }],
      "properties": {
        "enabled": { "enum": [true, false, "auto"] }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "ingressTls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "secretName": { "type": "string" },
          "hosts": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 56 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"],
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "baseUrl": {
      "description": "Public URL of the status page (BASE_URL), required.",
      "$ref": "#/definitions/url"
    },
    "config": {
      "description": "Non-secret environment variables of docs/configuration.md.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "TRUST_PROXY": { "$ref": "#/definitions/envValue" },
        "LOG_LEVEL": { "enum": ["", null, "fatal", "error", "warn", "info", "debug", "trace", "silent"] },
        "SCHEMA_WAIT_SECONDS": { "$ref": "#/definitions/intString" },
        "SESSION_TTL_HOURS": { "$ref": "#/definitions/intString" },
        "SESSION_MAX_AGE_HOURS": { "$ref": "#/definitions/intString" },
        "LOCAL_LOGIN_ENABLED": { "$ref": "#/definitions/boolString" },
        "OIDC_ISSUER_URL": { "type": "string" },
        "OIDC_CLIENT_ID": { "type": "string" },
        "OIDC_SCOPES": { "type": "string" },
        "OIDC_LABEL": { "type": "string" },
        "OIDC_GROUPS_CLAIM": { "type": "string" },
        "OIDC_ADMIN_GROUP": { "type": "string" },
        "OIDC_EDITOR_GROUP": { "type": "string" },
        "OIDC_AUTO_CREATE_USERS": { "$ref": "#/definitions/boolString" },
        "BUNDLE_PUSH_STALE_SECONDS": { "$ref": "#/definitions/intString" },
        "MAX_CHECKS_PER_SOURCE": { "$ref": "#/definitions/intString" },
        "POLL_MAX_RESPONSE_MB": { "$ref": "#/definitions/numberString" },
        "POLL_MAX_VALUES": { "$ref": "#/definitions/intString" },
        "MAIL_TRANSPORT": { "enum": ["", null, "smtp", "log", "none"] },
        "SMTP_HOST": { "type": "string" },
        "SMTP_PORT": { "$ref": "#/definitions/intString" },
        "SMTP_SECURE": { "$ref": "#/definitions/boolString" },
        "SMTP_USER": { "type": "string" },
        "SMTP_FROM": { "type": "string" },
        "SMTP_TLS_REJECT_UNAUTHORIZED": { "$ref": "#/definitions/boolString" },
        "UMAMI_URL": { "type": "string", "pattern": "^(|https?://[^?#\\s]+)$" },
        "ALLOW_UNRESTRICTED_PUBLIC_DB": { "$ref": "#/definitions/boolString" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "description": "Existing Secret with SECRET_KEY and the optional ADMIN_*, SMTP_PASSWORD, OIDC_CLIENT_SECRET. In split mode it requires publicExistingSecret.",
          "$ref": "#/definitions/secretName"
        },
        "publicExistingSecret": {
          "description": "Split mode: existing Secret with only SUBSCRIPTION_TOKEN_KEY, the only token Secret the public pods reference. Required with existingSecret in split mode; must differ from existingSecret and database.existingSecret.",
          "$ref": "#/definitions/secretName"
        },
        "secretKey": { "type": "string" },
        "subscriptionTokenKey": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminPassword": { "type": "string" },
        "smtpPassword": { "type": "string" },
        "oidcClientSecret": { "type": "string" }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "url": { "$ref": "#/definitions/postgresUrl" },
        "existingSecret": {
          "description": "Existing Secret with the owner role's URL. Never referenced by the public pods.",
          "$ref": "#/definitions/secretName"
        },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "public": {
          "type": "object",
          "properties": {
            "url": { "$ref": "#/definitions/postgresUrl" },
            "existingSecret": {
              "description": "Split mode: existing Secret with the public role's URL, referenced by the public pods. Must differ from database.existingSecret and secrets.existingSecret.",
              "$ref": "#/definitions/secretName"
            },
            "existingSecretKey": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      },
      "additionalProperties": false
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "strategy": { "$ref": "#/definitions/strategy" },
    "split": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "public": { "$ref": "#/definitions/component" },
        "admin": {
          "allOf": [{ "$ref": "#/definitions/component" }],
          "properties": {
            "baseUrl": { "$ref": "#/definitions/url" },
            "strategy": { "$ref": "#/definitions/strategy" }
          }
        },
        "worker": { "$ref": "#/definitions/component" }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "$ref": "#/definitions/percentOrEmpty" },
        "targetMemoryUtilizationPercentage": { "$ref": "#/definitions/percentOrEmpty" }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "path": { "type": "string", "pattern": "^/" },
        "pathType": { "enum": ["Prefix", "ImplementationSpecific", "Exact"] },
        "tls": { "$ref": "#/definitions/ingressTls" },
        "admin": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "tls": { "$ref": "#/definitions/ingressTls" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "$ref": "#/definitions/resources" },
    "probes": {
      "type": "object",
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      },
      "additionalProperties": false
    },
    "tmpSizeLimit": { "type": "string", "minLength": 1 },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "$ref": "#/definitions/list" },
    "affinity": { "$ref": "#/definitions/object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "properties": {
            "from": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        },
        "egress": {
          "type": "object",
          "properties": {
            "dns": { "allOf": [{ "$ref": "#/definitions/egressRule" }], "properties": { "enabled": { "type": "boolean" } } },
            "postgres": { "allOf": [{ "$ref": "#/definitions/egressRule" }], "properties": { "enabled": { "type": "boolean" } } },
            "smtp": { "$ref": "#/definitions/autoEgressRule" },
            "monitoring": { "allOf": [{ "$ref": "#/definitions/egressRule" }], "properties": { "enabled": { "type": "boolean" } } },
            "oidc": { "$ref": "#/definitions/autoEgressRule" },
            "umami": { "$ref": "#/definitions/autoEgressRule" },
            "extra": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
