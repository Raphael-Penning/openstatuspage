# OpenStatusPage settings for an installation without containers:
# /etc/openstatuspage/openstatuspage.env (mode 0640, owner root, group
# openstatuspage; it holds secrets). Read by the systemd units (EnvironmentFile)
# and by the CLI commands (ENV_FILE). Every option of docs/configuration.md can
# be set here; restart the service after a change:
#   systemctl restart openstatuspage   (or openstatuspage-split.target)
#
# Format: KEY=value, one per line, no "export". Quote values with spaces:
# SMTP_FROM="Example Status <status@example.com>". Do not set APP_ROLE here:
# each unit sets its role.

# --- Server ---------------------------------------------------------------------
# Public URL of the status page, without trailing slash.
BASE_URL=https://status.example.com
# Listen on localhost only, for a reverse proxy on the same host (deploy/proxy/).
HOST=127.0.0.1
PORT=3000
# One reverse proxy on the same host. A hop count is safe while the port only
# listens on 127.0.0.1; otherwise list the proxy's addresses.
TRUST_PROXY=1
# LOG_LEVEL=info

# --- Database ---------------------------------------------------------------------
# SQLite in the state directory, or PostgreSQL, e.g.
# DATABASE_URL=postgres://osp_app:<password>@127.0.0.1:5432/openstatuspage
DATABASE_URL=sqlite:/var/lib/openstatuspage/openstatuspage.db

# --- Secrets ----------------------------------------------------------------------
# At least 32 characters; install.sh and the packages generate it. Changing it
# makes stored monitoring credentials unreadable.
SECRET_KEY=

# --- First admin -------------------------------------------------------------------
# Only used while no user exists. Remove the password after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Themes -----------------------------------------------------------------------
# Theme files (<id>.json, optional <id>.css; docs/themes.md) are read from
# /etc/openstatuspage/themes on start (the systemd units set THEMES_DIR; the
# public instance of the split deployment gets the folder read-only). Files
# must be readable by everyone: chmod 0644. Restart after a change.
# THEMES_DIR=/etc/openstatuspage/themes

# --- Email ------------------------------------------------------------------------
# The local send-only Postfix of "install.sh --with-postfix":
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_FROM="Status <status@example.com>"
# MAIL_DKIM_DIR=/etc/openstatuspage/dkim
# Or any other SMTP server (docs/configuration.md#email-notifications):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=status@example.com
# SMTP_PASSWORD=
