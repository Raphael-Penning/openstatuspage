# OpenStatusPage split deployment: the public instance (APP_ROLE=public: status
# page, public API, feeds, subscriptions). It runs as its own user, which cannot
# read /etc/openstatuspage/openstatuspage.env (SECRET_KEY, the owner database
# login): its settings are in /etc/openstatuspage/public.env only. Needs
# PostgreSQL and the restricted database role (deploy/postgres/roles.sql).
[Unit]
Description=OpenStatusPage public instance
Documentation=https://github.com/Raphael-Penning/openstatuspage/tree/main/docs/guide
Wants=network-online.target
After=network-online.target postgresql.service openstatuspage-admin.service
PartOf=openstatuspage-split.target
Conflicts=openstatuspage.service

[Service]
Type=simple
User=openstatuspage-public
Group=openstatuspage-public
# Themes folder (docs/themes.md): this user cannot enter /etc/openstatuspage, so
# /etc/openstatuspage/themes is bound read-only to /opt/openstatuspage/themes.
Environment=THEMES_DIR=/opt/openstatuspage/themes
BindReadOnlyPaths=-/etc/openstatuspage/themes:/opt/openstatuspage/themes
EnvironmentFile=/etc/openstatuspage/public.env
ExecStart=/opt/openstatuspage/app/bin/openstatuspage serve public
WorkingDirectory=/opt/openstatuspage/app
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Resources: about 80-100 MB in use, short peaks above (docs/architecture.md#memory).
MemoryHigh=200M
MemoryMax=256M
TasksMax=64
LimitNOFILE=8192

# Hardening. Nothing is writable except a private /tmp. No
# MemoryDenyWriteExecute: the V8 JIT needs writable code pages.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=openstatuspage-split.target
