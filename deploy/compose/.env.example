# OpenStatusPage settings for compose.yaml. Save this file as .env next to
# compose.yaml (chmod 600, it holds secrets). Every option from the
# configuration reference can be added here:
# https://github.com/Raphael-Penning/openstatuspage/blob/main/docs/configuration.md
#
# SECRET_KEY and POSTGRES_PASSWORD are not part of this template: the install
# command appends freshly generated values at the end of this file. Keep a copy
# of both. Changing SECRET_KEY makes stored monitoring credentials unreadable;
# POSTGRES_PASSWORD is only applied when the database is created.
#
# POSTGRES_PASSWORD is embedded in a connection URL: if you set it yourself,
# use letters and digits only. PORT and HOST are fixed by compose.yaml; use
# HOST_PORT to change the published port.
#
# Notes: empty values count as unset. Compose interpolates "$" in values, so
# avoid it or wrap the whole value in single quotes, e.g. SMTP_PASSWORD='pa$$'.

# --- Server ---------------------------------------------------------------------
# Public URL of the status page, without trailing slash. Links in emails, feeds
# and OIDC redirects use it; with https:// cookies are marked Secure.
BASE_URL=https://status.example.com

# Published port on the host. Use 127.0.0.1:3000 when the reverse proxy runs on
# the same host, so the app is not reachable around the proxy.
HOST_PORT=3000

# Number of reverse proxies in front of the app (1 for a single proxy), or a
# comma separated list of trusted proxy addresses. Leave empty without a proxy.
TRUST_PROXY=1

# Image tag: "latest" is the newest stable release. Pin a release such as 0.1.0
# for production and change it deliberately when upgrading.
OSP_VERSION=latest
# Another registry or a fork's image:
# OSP_IMAGE=ghcr.io/raphael-penning/openstatuspage

# fatal, error, warn, info (default), debug, trace or silent
# LOG_LEVEL=info

# --- First admin -------------------------------------------------------------------
# Only used while no user exists (password at least 10 characters). Remove the
# password after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (subscriptions, notifications) -----------------------------------------
# smtp (default when SMTP_HOST is set), log or none
MAIL_TRANSPORT=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true = implicit TLS (usually port 465), false = STARTTLS when offered
# SMTP_SECURE=false
# SMTP_USER=status@example.com
# SMTP_PASSWORD=
# SMTP_FROM='Example Status <status@example.com>'
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Single sign-on (optional, OpenID Connect) ------------------------------------
# Redirect URI to register at the IdP: <BASE_URL>/api/auth/oidc/callback
# OIDC_ISSUER_URL=https://idp.example.com/realms/example
# OIDC_CLIENT_ID=openstatuspage
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUP=statuspage-admins
# OIDC_EDITOR_GROUP=statuspage-editors
# OIDC_AUTO_CREATE_USERS=false
# LOCAL_LOGIN_ENABLED=true

# --- Generated secrets (appended by the install command) --------------------------
