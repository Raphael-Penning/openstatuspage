# Copy to .env and adjust. Every option is read from the environment.

# --- Server -------------------------------------------------------------------
# Defaults to production (`pnpm dev` uses development)
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# Public URL of the status page (used for feeds, OIDC redirects and ingest URLs)
BASE_URL=http://localhost:3000
# Behind a reverse proxy (nginx, Traefik, Caddy, ...): number of proxy hops in front
# of the app (`true` = 1) or a list of trusted proxy addresses, e.g. 10.0.0.0/8,127.0.0.1
# TRUST_PROXY=false
# LOG_LEVEL=info

# Required unless NODE_ENV=development. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Encrypts monitoring credentials at rest – changing it makes them unreadable.
SECRET_KEY=

# --- Database -----------------------------------------------------------------
# SQLite (default):
DATABASE_URL=sqlite:./data/openstatuspage.db
# PostgreSQL:
# DATABASE_URL=postgres://openstatuspage:secret@localhost:5432/openstatuspage

# --- Initial admin (only used when no user exists) ----------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# --- Authentication ---------------------------------------------------------------
# SESSION_TTL_HOURS=168
# LOCAL_LOGIN_ENABLED=true

# Optional OpenID Connect single sign-on (Keycloak, Authentik, Entra ID, Okta, ...)
# Redirect URI to register at the IdP: ${BASE_URL}/api/auth/oidc/callback
# OIDC_ISSUER_URL=https://idp.example.com/realms/example
# OIDC_CLIENT_ID=openstatuspage
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_LABEL=Single Sign-On
# OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUP=statuspage-admins
# OIDC_EDITOR_GROUP=statuspage-editors
# Create users on first login (default false: users must exist). Only enable together
# with OIDC_ADMIN_GROUP / OIDC_EDITOR_GROUP, otherwise every IdP account becomes an editor.
# OIDC_AUTO_CREATE_USERS=false

# --- Background worker ------------------------------------------------------------
# Disable polling/scheduling on additional replicas
# WORKER_ENABLED=true

# --- Email notifications (see docs/notifications.md) ------------------------------
# smtp (default when SMTP_HOST is set), log (write mails to the server log, for
# development) or none (default without SMTP_HOST: no email subscriptions)
# MAIL_TRANSPORT=
# SMTP_HOST=smtp.example.com
# Port 587 with STARTTLS (SMTP_SECURE=false) or port 465 with SMTP_SECURE=true
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=status@example.com
# SMTP_PASSWORD=
# Required for smtp and log
# SMTP_FROM=Example Status <status@example.com>
# Only disable for relays with self-signed certificates in a trusted network
# SMTP_TLS_REJECT_UNAUTHORIZED=true
