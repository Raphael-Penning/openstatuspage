# Read by openstatuspage-notify.sh via OSP_CONFIG. Not executed; only these keys are used.
# Restrict permissions: chmod 640, readable by the Icinga 2 user only.
OSP_URL=https://status.example.com/api/ingest/00000000-0000-0000-0000-000000000000/icinga2
OSP_TOKEN=replace-with-the-ingest-token
# OSP_INSECURE=1
